+;; The second operand of a fused overflow check: an immediate or a register, never a
+;; memory operand. The instruction that produced the flags is still lowered on its own
+;; when its result has other uses, and a load cannot be folded into both.
+(decl gpr_no_load (Value) GprMem)
+(rule (gpr_no_load val) (gpr_to_gpr_mem (put_in_gpr val)))
+
+(decl gpr_or_simm32 (Value) GprMemImm)
+(rule 1 (gpr_or_simm32 (simm32_from_value imm)) imm)
+(rule 0 (gpr_or_simm32 val) (gpr_to_gpr_mem_imm (put_in_gpr val)))
+
+;; The same for the signed and subtracting forms: `add`/`sub` set OF (signed) and CF
+;; (unsigned borrow) themselves, so a `brif` on the flag needs no `seto`/`setb`.
+(rule 8
+      (is_nonzero
+       (is_second_result sadd @ (sadd_overflow (fits_in_64 ty) x y)))
+      (if-let (first_result sum_value) sadd)
+      (let ((producer ProducesFlags (x64_add_with_flags_paired ty x (gpr_or_simm32 y))))
+        (CondResult.CC
+         (produces_flags_opportunistic_def producer sum_value)
+         (CC.O))))
+
+(rule 9
+      (is_nonzero
+       (is_second_result ssub @ (ssub_overflow (fits_in_64 ty) x y)))
+      (if-let (first_result diff_value) ssub)
+      (let ((producer ProducesFlags (x64_sub_with_flags_paired ty x (gpr_or_simm32 y))))
+        (CondResult.CC
+         (produces_flags_opportunistic_def producer diff_value)
+         (CC.O))))
+
+(rule 10
+      (is_nonzero
+       (is_second_result usub @ (usub_overflow (fits_in_64 ty) x y)))
+      (if-let (first_result diff_value) usub)
+      (let ((producer ProducesFlags (x64_sub_with_flags_paired ty x (gpr_or_simm32 y))))
+        (CondResult.CC
+         (produces_flags_opportunistic_def producer diff_value)
+         (CC.B))))
+
 ;; Using the flags output of `umul_overflow`/`smul_overflow` can produce a
 ;; `CC` and give an opportunistic def of the other output. The multiply
 ;; itself sets the overflow flag (OF for `imul`; OF==CF for the unsigned
@@ -3894,7 +3933,7 @@
       (is_nonzero
        (is_second_result umul @ (umul_overflow _ x y @ (value_type (ty_int_ref_16_to_64 ty)))))
